{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "apescic/exotic-animal-shelter-manager",
    "type": "project",
    "description": "Exotic Animal Shelter Manager (EASM): self-hosted shelter software for exotic species on generic PHP and MySQL/MariaDB hosting.",
    "keywords": ["easm", "shelter", "exotic", "laravel", "apes"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scripts\\MilestoneVersion\\": "scripts/MilestoneVersion/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/herd-setup.ps1"
        ],
        "post-install-cmd": [
            "@php scripts/ensure-env.php"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npm run dev"
        ],
        "demo:seed": "@php artisan demo:seed",
        "demo:reset": "@php artisan demo:reset",
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "format": [
            "@php vendor/bin/pint"
        ],
        "milestone:next": "@php scripts/milestone-version next",
        "milestone:branch": "@php scripts/milestone-version branch",
        "milestone:pr-title": "@php scripts/milestone-version pr-title",
        "milestone:check-title": "@php scripts/milestone-version check-title",
        "milestone:check-branch": "@php scripts/milestone-version check-branch",
        "milestone:check-release": "@php scripts/milestone-version check-release",
        "milestone:bump": "@php scripts/milestone-version bump",
        "milestone:status": "@php scripts/milestone-version status",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
