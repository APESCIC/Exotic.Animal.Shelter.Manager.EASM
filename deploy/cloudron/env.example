# EASM settings on the APES Cloudron LAMP app. activate-release.sh copies this to
# /app/data/shared/.env on the first deploy and adds a new APP_KEY; the install wizard
# writes APP_NAME, APP_TIMEZONE and APP_INSTALLED. There are no DB_* or MAIL_* lines:
# EASM reads Cloudron's CLOUDRON_MYSQL_* and CLOUDRON_MAIL_* variables instead.
# APP_VERSION is not set here, so /health reports the version in the release.

APP_NAME="Exotic Animal Shelter Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://easm.intranet.apes.org.uk
APP_INSTALLED=false

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en_GB
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=Europe/London

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

DEV_AUTO_LOGIN=false
